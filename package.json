{
  "name": "ham-boilerplate-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate monorepo (Next.js + NestJS) pronto para Claude Code + deploy Coolify via push GitHub.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "2.5.0",
      "body-parser@<1.20.9": "1.20.9",
      "proxy-addr@<2.0.8": "2.0.8",
      "lodash@<4.18.0": "4.18.1",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <2.1.7": "2.1.7",
      "nanoid@<3.3.20": "3.3.20",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "@grpc/grpc-js@<1.13.6": "1.14.7",
      "postcss@<8.5.18": "8.5.32",
      "source-map-js@<1.2.2": "1.2.2",
      "qs@<6.16.1": "6.16.1",
      "fflate@<0.8.3": "0.8.3"
    }
  }
}
