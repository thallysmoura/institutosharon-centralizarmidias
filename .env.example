# ============================================================
# Variáveis de ambiente - copie para .env e ajuste por ambiente
# ============================================================

# ----- Web (Next.js) -----
# URL pública usada pelo browser para chamar a API
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL interna (server-side) - em produção no Coolify, usar nome do serviço
INTERNAL_API_URL=http://localhost:3001
# Banner global de ambiente não-produtivo. Ativo por padrão (todo clone roda como homologação).
# Ao fazer deploy em main (produção), apague essa variável no Coolify.

# ----- API (NestJS) -----
PORT=3001
NODE_ENV=development
# Origens permitidas pelo CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:3000

# Banco de dados (descomente quando adicionar)
# DATABASE_URL=postgresql://user:pass@localhost:5432/app

# Auth (exemplo)
# JWT_SECRET=changeme
# JWT_EXPIRES_IN=7d

# Login com Google (Firebase). Caminho do JSON da conta de serviço - NUNCA commitar.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Armazenamento das fotos: local (dev) ou s3 (Cloudflare R2, bucket privado + URL assinada)
STORAGE_DRIVER=local
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=instituto-sharon-fotos
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Contas de demonstração (aluno@/aluno2@institutosharon.local). Deixe false em produção.
SEED_DEMO=false

# E-mail (PIN) - Gmail com senha de app. MAIL_MODE=log só registra no log (dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Instituto Sharon <seu-email@gmail.com>
MAIL_MODE=
# URL pública do front (link "Copiar código" do e-mail)
APP_URL=
